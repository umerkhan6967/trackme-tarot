{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/fortune.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/fortune", "destination": "/api/fortune.js" },
    { "source": "/api/network", "destination": "/api/network.js" }
  ]
}
